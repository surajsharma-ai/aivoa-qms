# Create a Groq API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=gemma2-9b-it
# Optional fallback model for richer context when enabled
# Use a currently available Groq model as a fallback if Gemma is retired. Verify availability for your key.
GROQ_CONTEXT_MODEL=openai/gpt-oss-120b
# Use PostgreSQL in a real deployment. The app falls back to a local SQLite file for the demo.
DATABASE_URL=postgresql+psycopg://qms:qms@localhost:5432/aivoa_qms
